# Copy to .env and fill in your own values. Never commit .env.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/orion
JWT_SECRET_KEY=change-me-to-a-long-random-string
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SIEM_ENCRYPTION_KEY=change-me

# Language model: leave empty to use the rule-based fallback only
GEMINI_API_KEY=
# To use a local or other OpenAI-compatible model instead:
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=
